# --- Backend configuration (copy to backend/.env) ---

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/livepass_db"

# Secret used to sign JWTs and QR tokens (use a long random value)
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: enables AI-generated organizer insights
GEMINI_API_KEY=""
# Optional fallback key read by the insights service
QWEN_API_KEY=""

# Reserved for deployment
PORT=5000
FRONTEND_URL="http://localhost:5173"
